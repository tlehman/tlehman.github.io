# Build the WASI coreutils multicall binary used by index.html.
# Needs only clang with the wasm32 backend and wasm-ld (no wasi-libc).
#
# coreutils.wasm.js embeds the binary as base64 so the page works when
# opened from file:// as well as over http(s); browsers refuse to fetch()
# local files.
#
# texsh.js bundles the browser-safe parts of texsh and opentui-math for the
# `texsh` builtin; it needs git, network access and bun.
CC ?= clang
CFLAGS = --target=wasm32 -nostdlib -ffreestanding -O2 -Wall -Wextra -Wno-unused-parameter
LDFLAGS = -Wl,--export=_start -Wl,--strip-all -Wl,-z,stack-size=65536
TEXSH_REF ?= main
OPENTUI_MATH_REF ?= v0.1.0

all: coreutils.wasm.js texsh.js

coreutils.wasm: coreutils.c
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $<

coreutils.wasm.js: coreutils.wasm
	printf '// generated from coreutils.wasm by make; do not edit\nwindow.COREUTILS_WASM = "%s";\n' "$$(base64 -w0 $<)" > $@

texsh.js: texsh/entry.ts
	rm -rf texsh/vendor
	git clone -q --depth 1 --branch $(TEXSH_REF) https://github.com/tlehman/texsh texsh/vendor/texsh
	git clone -q --depth 1 --branch $(OPENTUI_MATH_REF) https://github.com/neriousy/opentui-math texsh/vendor/opentui-math
	bun build texsh/entry.ts --target=browser --format=iife --minify --outfile=$@ \
	  --banner='// generated by make from github.com/tlehman/texsh@$(TEXSH_REF) and github.com/neriousy/opentui-math@$(OPENTUI_MATH_REF) (both MIT); do not edit'

clean:
	rm -f coreutils.wasm coreutils.wasm.js texsh.js
	rm -rf texsh/vendor

.PHONY: all clean
